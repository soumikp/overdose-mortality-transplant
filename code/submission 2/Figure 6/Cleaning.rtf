\f0\b\fs36 \cf0 Cleaning Steps\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 Step 1: Filter Status History File\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Open 
\f2\fs26 stathist_liin.sas7bdat
\f1\fs24 . Filter to status episodes that overlap the study period:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 CANHX_BEGIN_DT <= 12/31/2024  AND  (MISSING(CANHX_END_DT)  OR  CANHX_END_DT >= 1/1/2015)\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Expected N = 1,707,299 rows
\f1\b0 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 2: Filter to Liver Candidates\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Filter the file from Step 1 to liver candidates only:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 WL_ORG = "LI"\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Expected N = 1,704,214 rows
\f1\b0 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 3: Deduplicate Candidate File\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Open 
\f2\fs26 cand_liin.sas7bdat
\f1\fs24 . Check for duplicates by 
\f2\fs26 PX_ID
\f1\fs24 . No duplicates were found.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Expected N = 389,906 unique rows
\f1\b0 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 4: Merge Status History and Candidate Files\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Merge the filtered status history file (Step 2) with the candidate file (Step 3) to add candidate variables.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0
\f0\b \cf0 \kerning1\expnd0\expndtw0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
