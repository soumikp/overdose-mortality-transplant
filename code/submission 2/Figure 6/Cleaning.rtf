\f1\b0  
\f2\fs26 CAN_LISTING_CTR_CD
\f1\fs24  and 
\f2\fs26 CAN_LISTING_CTR_TY
\f1\fs24 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 6: Exclude Puerto Rico Listings\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create variable based on the listing center's state from the institution file:\
\pard\pardeftab720\partightenfactor0

