\f0\b\fs36 \cf0 \strokec2 Cleaning Steps\
\pard\pardeftab720\sa280\partightenfactor0

\fs28 \cf0 Step 1: Combine Transplant Files\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Merge 
\f2\fs26 TX_KI.sav
\f1\fs24  and 
\f2\fs26 TX_KP.sav
\f1\fs24  to combine rows (append kidney and kidney-pancreas transplant records into a single dataset).\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Expected N = 640,392 rows
\f1\b0 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 2: Merge Institution Data\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Merge the combined file from Step 1 with 
\f2\fs26 INSTITUTION.sav
\f1\fs24  to add transplant center variables.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls4\ilvl0
\f0\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Linking variables:
\f1\b0  
\f2\fs26 REC_CTR_CD
\f1\fs24  and 
\f2\fs26 REC_CTR_TY
\f1\fs24 \
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 3: Merge Donor Data\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Merge the file from Step 2 with 
\f2\fs26 DONOR_DECEASED.sav
\f1\fs24  to add deceased donor variables.\
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls5\ilvl0
\f0\b \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Linking variable:
\f1\b0  
\f2\fs26 DONOR_ID
\f1\fs24 \
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Note:
\f1\b0  
\f2\fs26 DON_DEATH_MECH
\f1\fs24  is already present in TX_KI and TX_KP. This merge adds additional donor variables used elsewhere in the analysis (e.g., Table 1).\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 4: Flag Kidney and Kidney-Pancreas Transplants\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create variable:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 Kidney_OR_KP = 1  IF  ORG_TY = "KI"  OR  ORG_TY = "KP"\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 5: Flag Puerto Rico Recipients\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create variable:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 Puerto_Rico_Recipient = 1  IF  REC_PRIMARY_STATE = "PR"\
Puerto_Rico_Recipient = 0  OTHERWISE\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 6: Define US Deceased Donor Kidney Transplant Cohort\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create variable:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 USDDKT = 1  IF  Kidney_OR_KP = 1\
              AND  Puerto_Rico_Recipient = 0\
              AND  DON_TY = "C"\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 7: Create Year-Month Variable\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Create variable:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 TxYYYYMM = (XDATE.YEAR(REC_TX_DT) * 100) + XDATE.MONTH(REC_TX_DT)\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Step 8: Apply Inclusion Criteria\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Select cases where:\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 TxYYYYMM >= 201501  AND  TxYYYYMM <= 202412  AND  USDDKT = 1\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Expected N = 176,544 rows in the final analytic cohort
\f1\b0 \
\pard\pardeftab720\sa280\partightenfactor0

